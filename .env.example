# =============================================================================
# RandomStack — .env RACINE (Docker Compose)
# Copier : cp .env.example .env
# =============================================================================
# Ce fichier est lu par `docker compose` uniquement.
# Pour lancer le server hors Docker → voir apps/server/.env.example
# =============================================================================

# ─── Postgres (service postgres_db) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=randomstack
POSTGRES_HOST_PORT=5435

# Host = nom du service Docker (pas localhost)
DATABASE_URL=postgresql://postgres:changeme@postgres_db:5432/randomstack?schema=public

# ─── API Express ────────────────────────────────────────────────────────────
PORT=4000
SESSION_SECRET=change-me-session-secret
# Comptes seed (1 par rôle)
ADMIN_EMAIL=admin@randomstack.com
ADMIN_PASSWORD=changeme
MODERATOR_EMAIL=moderateur@randomstack.com
MODERATOR_PASSWORD=changeme
EDITOR_EMAIL=editeur@randomstack.com
EDITOR_PASSWORD=changeme
AUTHOR_EMAIL=auteur@randomstack.com
AUTHOR_PASSWORD=changeme
USER_EMAIL=user@randomstack.com
USER_PASSWORD=changeme

# ─── Fronts (URL vue depuis le navigateur host) ─────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_EXTRANET_URL=http://localhost:5175
CLIENT_PORT=5173
EXTRANET_PORT=5175
PRISMA_STUDIO_PORT=5555

# ─── CORS (API) ─────────────────────────────────────────────────────────────
# Dev / Bruno
CORS_ALLOW_ALL=true
# Prod (Railway) — mettre false + origines Cloudflare :
# CORS_ALLOW_ALL=false
# CLIENT_ORIGIN=https://www.randomstack.io
# EXTRANET_ORIGIN=https://admin.randomstack.io
# CORS_ORIGINS=

# ─── Railway Bucket (optionnel en Docker local) ─────────────────────────────
# Laisser vide → disque local public/uploads
# Remplir pour tester le vrai bucket depuis Docker
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
