# Copier vers .env à la racine : cp .env.example .env

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=randomstack
POSTGRES_HOST_PORT=5435

# URL containers (host = service docker `postgres_db`)
DATABASE_URL=postgresql://postgres:changeme@postgres_db:5432/randomstack?schema=public

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
SESSION_SECRET=change-me-session-secret

ADMIN_EMAIL=admin@randomstack.com
ADMIN_PASSWORD=changeme

# ─── Fronts ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

PRISMA_STUDIO_PORT=5555
CLIENT_PORT=5173
EXTRANET_PORT=5175
