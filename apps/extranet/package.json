{
  "name": "extranet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite"
  },
  "imports": {
    "#pages": {
      "development": "./src/pages/index.ts",
      "default": "./dist/pages/index.js"
    },
    "#services": {
      "development": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    },
    "#scripts": {
      "development": "./src/scripts/index.ts",
      "default": "./dist/scripts/index.js"
    },
    "#components": {
      "development": "./src/lib/components/index.ts",
      "default": "./dist/lib/components/index.js"
    },
    "#utils": {
      "development": "./src/lib/utils/index.ts",
      "default": "./dist/lib/utils/index.js"
    }
  },
  "dependencies": {
    "@randomstack/commons": "*",
    "vue": "^3.4.15",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^5.0.3",
    "postcss": "^8.5.25",
    "sass": "^1.102.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vue-tsc": "^1.8.27"
  }
}
