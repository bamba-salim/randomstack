{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "NodeNext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "#config": ["./src/config/index.ts"],
      "#db": ["./src/lib/db/index.ts"],
      "#middlewares": ["./src/lib/middlewares/index.ts"],
      "#routes": ["./src/routes/index.ts"],
      "#controllers": ["./src/controllers/index.ts"],
      "#action-support": ["./src/action-support/index.ts"],
      "#models": ["./src/models/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}