datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DESKTOP
}

enum Role {
  USER
  MODERATOR
  EDITOR
  ADMIN
}

model Technology {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique // Format: {nom-de-la-techno}-uuid
  language    String
  logo        String?
  usage       String
  categories  Category[]
  isActive    Boolean           @default(true) // Disponible uniquement au tirage ou non
  createdAt   DateTime          @default(now())

  // Relation 1-à-1 : detail.id est la clé primaire ET la clé étrangère référençant l'ID de Technology 🚀
  detail      TechnologyDetail?
}

// 2. Modèle de détails d'une technologie (Lourd)
model TechnologyDetail {
  id           String     @id // Clé primaire identique à Technology.id (sélecteur partagé) 🚀
  technology   Technology @relation(fields: [id], references: [id], onDelete: Cascade)

  websiteUrl   String?
  docsUrl      String?
  creator      String?
  foundedAt    String?    // Date/Année de création de la techno (ex: "2013")
  versions     Json?      // JSON stockant { stable: { num: "...", date: "..." }, latest: { num: "...", date: "..." } }
  userCount    Int?       // Nombre d'utilisateurs (ex: étoiles GitHub)
  projectCount Int?       // Nombre de projets
  history      String[]   // Tableau sémantique de paragraphes
  description  String?    @db.Text // Rendu nullable avec un "?" 🚀
}

model SavedStack {
  id          String   @id @default(uuid())
  shareCode   String   @unique
  projectType Category
  frontendId  String
  backendId   String
  databaseId  String
  ormId       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  savedStacks  SavedStack[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
