datasource db {
  provider = "postgresql"
  // L'URL de connexion est lue depuis apps/server/prisma.config.ts en Prisma v7 🚀
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DESKTOP
}

enum Role {
  USER
  MODERATOR
  EDITOR
  ADMIN
}

// 1. Statuts de publication enrichis pour le Soft Delete 🚀
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
  DELETED // Statut Corbeille pour suppression temporaire ou purge automatique 🚀
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model Technology {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique // Format: {nom-de-la-techno}-uuid
  language   String
  logo       String?
  usage      String
  categories Category[]
  isActive   Boolean    @default(true) // Disponible uniquement au tirage ou non
  createdAt  DateTime   @default(now())

  // Relation 1-à-1 : info.id = Technology.id
  info TechnologyInfo?
}

// Infos enrichies d'une technologie (table lourde)
model TechnologyInfo {
  id         String     @id // Clé primaire identique à Technology.id
  technology Technology @relation(fields: [id], references: [id], onDelete: Cascade)

  websiteUrl   String?
  docsUrl      String?
  creator      String?
  foundedAt    String?
  versions     Json?
  userCount    Int?
  projectCount Int?
  history      String[]
  description  String?  @db.Text

  @@map("TechnologyDetail") // conserve le nom de table existant en BDD
}

model SavedStack {
  id          String   @id @default(uuid())
  shareCode   String   @unique
  projectType Category
  frontendId  String
  backendId   String
  databaseId  String
  ormId       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modèle User lié bidirectionnellement aux commentaires 🚀
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  savedStacks  SavedStack[]
  comments     Comment[] // Lien de relation obligatoire avec les commentaires 🚀
}

// Modèle Post enrichi des tags, de la sécurité de publication et des commentaires 🚀
model Post {
  id               String     @id @default(uuid())
  title            String
  slug             String     @unique
  summary          String     @db.Text
  content          Json
  status           PostStatus @default(DRAFT)
  tags             String[]
  hasBeenPublished Boolean    @default(false)
  isFeatured       Boolean    @default(false) // <-- NOUVEAU : Article à la une 🌟
  authorIds        String[]
  publishAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  comments         Comment[]

  imageId String?
  image   File?   @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([slug]) // Index de performance pour charger les articles instantanément via le slug
}

// Nouveau modèle de Commentaires V2.5/V3 🚀
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text // Texte uniquement
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  type      FileType @default(IMAGE)
  category  String // ex: "technology", "post"
  extension String // ex: ".png", ".jpg"
  mimeType  String
  size      Int
  altText   String? // Texte alternatif pour l'accessibilité et le SEO 🚀
  createdAt DateTime @default(now())

  // Relations inverses
  posts Post[]
}
