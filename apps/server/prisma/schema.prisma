datasource db {
  provider = "postgresql"
  // L'URL de connexion est lue depuis apps/server/prisma.config.ts en Prisma v7 🚀
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DESKTOP
}

enum Role {
  USER
  AUTHOR
  MODERATOR
  EDITOR
  ADMIN
}

// 1. Statuts de publication enrichis pour le Soft Delete 🚀
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
  DELETED // Statut Corbeille pour suppression temporaire ou purge automatique 🚀
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum VoteType {
  LIKE
  DISLIKE
}

model Technology {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique // Format: {nom-de-la-techno}-uuid
  language   String
  logo       String?
  usage      String
  categories Category[]
  isActive   Boolean    @default(true) // Disponible uniquement au tirage ou non
  createdAt  DateTime   @default(now())

  // Relation 1-à-1 : detail.id = Technology.id
  detail TechnologyInfo?
}

// Infos enrichies d'une technologie (table lourde)
model TechnologyInfo {
  id         String     @id // Clé primaire identique à Technology.id
  technology Technology @relation(fields: [id], references: [id], onDelete: Cascade)

  websiteUrl   String?
  docsUrl      String?
  creator      String?
  foundedAt    String?
  versions     Json?
  userCount    Int?
  projectCount Int?
  history      String[]
  description  String?  @db.Text
}

model SavedStack {
  id          String   @id @default(uuid())
  shareCode   String   @unique
  projectType Category
  frontendId  String
  backendId   String
  databaseId  String
  ormId       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth uniquement — le profil public vit dans UserProfile
model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  savedStacks   SavedStack[]
  comments      Comment[]
  commentVotes  CommentVote[]
  favorites     PostFavorite[]
  profile       UserProfile?
  authoredPosts Post[]
}

// Profil public (bio, photo, portfolio) — id = User.id
model UserProfile {
  id               String     @id
  user             User       @relation(fields: [id], references: [id], onDelete: Cascade)
  displayName      String
  bio              String?    @db.Text
  photoId          String?
  photo            File?      @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /** Afficher la liste des favoris sur le profil public */
  favoritesPublic  Boolean    @default(false)
  links            UserLink[]
  updatedAt        DateTime   @updatedAt
}

// Liens portfolio (GitHub, site, etc.)
model UserLink {
  id        String      @id @default(uuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([profileId])
}

// Modèle Post enrichi des tags, de la sécurité de publication et des commentaires 🚀
model Post {
  id               String     @id @default(uuid())
  title            String
  slug             String     @unique
  /// Lien de partage `/post/:shareCode` → redirige vers `/:tag/:slug`
  shareCode        String     @unique
  summary          String     @db.Text
  content          Json
  status           PostStatus @default(DRAFT)
  tags             String[]
  /// Sources / crédits (URLs ou libellés), gérées comme les tags
  sources          String[]   @default([])
  hasBeenPublished Boolean    @default(false)
  isFeatured       Boolean    @default(false)
  authorId         String?
  author           User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishAt        DateTime?
  /// Rempli au soft-delete ; purge hard après 90 jours (cron)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  comments         Comment[]
  favorites        PostFavorite[]

  imageId      String?
  image        File?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// Légende de l’illustration principale (cover)
  imageCaption String?

  @@index([slug])
  @@index([shareCode])
  @@index([authorId])
  @@index([status, publishAt])
  @@index([deletedAt])
}

/** Marque-page / article favori (compte connecté) */
model PostFavorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// Commentaires publics (like/dislike réservés aux comptes connectés)
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  votes CommentVote[]

  @@index([postId])
  @@index([userId])
}

model CommentVote {
  id        String   @id @default(uuid())
  type      VoteType
  createdAt DateTime @default(now())

  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model File {
  id        String   @id @default(uuid())
  type      FileType @default(IMAGE)
  category  String // ex: "technology", "post"
  extension String // ex: ".png", ".jpg"
  mimeType  String
  size      Int
  altText   String? // Texte alternatif pour l'accessibilité et le SEO 🚀
  createdAt DateTime @default(now())

  // Relations inverses
  posts         Post[]
  profilePhotos UserProfile[]
}
