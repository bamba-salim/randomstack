datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DESKTOP
}

enum Role {
  USER
  MODERATOR
  EDITOR
  ADMIN
}

model Technology {
  id          String   @id @default(uuid())
  name        String   @unique
  language    String
  logo        String?
  usage       String
  description String
  category    Category
  createdAt   DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}