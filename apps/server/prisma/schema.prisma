datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DESKTOP
}

enum Role {
  USER
  MODERATOR
  EDITOR
  ADMIN
}

model Technology {
  id          String   @id @default(uuid())
  name        String   @unique
  language    String
  logo        String?
  usage       String
  description String
  category    Category[]
  createdAt   DateTime @default(now())
}

model SavedStack {
  id          String   @id @default(uuid())
  shareCode   String   @unique
  projectType Category
  frontendId  String
  backendId   String
  databaseId  String
  ormId       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  savedStacks  SavedStack[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
