{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "imports": {
    "#abstracts": {
      "development": "./src/abstracts/index.ts",
      "default": "./dist/abstracts/index.js"
    },
    "#file": {
      "development": "./src/modules/file/index.ts",
      "default": "./dist/modules/file/index.js"
    },
    "#blog": {
      "development": "./src/modules/blog/index.ts",
      "default": "./dist/modules/blog/index.js"
    },
    "#stack": {
      "development": "./src/modules/stack/index.ts",
      "default": "./dist/modules/stack/index.js"
    },
    "#user": {
      "development": "./src/modules/user/index.ts",
      "default": "./dist/modules/user/index.js"
    },
    "#db": {
      "development": "./src/lib/db/index.ts",
      "default": "./dist/lib/db/index.js"
    },
    "#middlewares": {
      "development": "./src/lib/middlewares/index.ts",
      "default": "./dist/lib/middlewares/index.js"
    },
    "#utils": {
      "development": "./src/lib/utils/index.ts",
      "default": "./dist/lib/utils/index.js"
    },
    "#scheduler": {
      "development": "./src/core/scheduler/index.ts",
      "default": "./dist/core/scheduler/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@randomstack/commons": "*",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "prisma": "^7.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
