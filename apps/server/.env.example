# =============================================================================
# apps/server — env LOCAL (npm run hors Docker) OU référence Railway
# Copier : cp apps/server/.env.example apps/server/.env.local
# =============================================================================
# Docker Compose ignore ce fichier → utilise le .env RACINE.
# dotenv charge : .env puis .env.local (cwd = apps/server ou racine selon script)
# =============================================================================

# ─── Database (port publié sur le host) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:devpassword@localhost:5435/randomstack?schema=public

# ─── API ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# TRUST_PROXY=1
PORT=4000
# >= 32 caractères en prod. Sessions persistées en PG (table `session`).
SESSION_SECRET=change-me-session-secret-min-32-chars
# Taille max body JSON (défaut serveur : 1mb). Uploads fichiers = multer 5 Mo à part.
# JSON_BODY_LIMIT=1mb
# Comptes seed (1 par rôle)
ADMIN_EMAIL=admin@randomstack.com
ADMIN_PASSWORD=changeme
MODERATOR_EMAIL=moderateur@randomstack.com
MODERATOR_PASSWORD=changeme
EDITOR_EMAIL=editeur@randomstack.com
EDITOR_PASSWORD=changeme
AUTHOR_EMAIL=auteur@randomstack.com
AUTHOR_PASSWORD=changeme
USER_EMAIL=user@randomstack.com
USER_PASSWORD=changeme

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL=true
# Go-live (NODE_ENV=production) : CORS_ALLOW_ALL=false + origines réelles
# CORS_ALLOW_ALL=false
# CLIENT_ORIGIN=https://www.randomstack.io
# EXTRANET_ORIGIN=https://admin.randomstack.io

# ─── Railway Bucket S3 ──────────────────────────────────────────────────────
# Dashboard Railway → Bucket → Credentials
# Sans ces 4 clés remplies → fallback public/uploads
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
