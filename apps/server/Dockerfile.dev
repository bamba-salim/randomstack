FROM node:22-alpine
WORKDIR /app

# Lockfile généré avec npm 12 (host Node 26) — npm 10 crash edgesOut
RUN npm install -g npm@12

# Tous les manifests workspaces avant install
COPY package*.json ./
COPY packages/commons/package*.json ./packages/commons/
COPY apps/server/package*.json ./apps/server/
COPY apps/client/package*.json ./apps/client/
COPY apps/extranet/package*.json ./apps/extranet/

RUN npm install

COPY . .

EXPOSE 4000
